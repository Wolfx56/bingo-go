# Example systemd unit for Bingo.
#
# Install:
#   sudo install -m 755 bingo /usr/local/bin/bingo
#   sudo install -m 644 deploy/bingo.service /etc/systemd/system/bingo.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bingo
#
# Logs: journalctl -u bingo -f

[Unit]
Description=Bingo - self-hosted bingo cards
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/bingo

# Listen address. ":8080" makes the app reachable from the local network;
# use "127.0.0.1:8080" to restrict it to this machine (behind a reverse proxy, for instance).
# The app has no authentication: do not expose it to the Internet as-is.
Environment=BINGO_ADDR=:8080
Environment=BINGO_DB=/var/lib/bingo/bingo.db

# Ephemeral system user + /var/lib/bingo data directory, both created by systemd.
DynamicUser=yes
StateDirectory=bingo
WorkingDirectory=/var/lib/bingo

Restart=on-failure
RestartSec=3

# Hardening: the service only needs the network and its data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
